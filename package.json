{
  "name": "dsh-store-replenish",
  "version": "0.1.0-alpha.1",
  "description": "Store-SKU replenishment suggestions, per-store replenishment plans and replenishment CSV; local files only.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES",
    "docs/assets",
    "CHANGELOG.md",
    "icon.svg",
    "samples",
    "TROUBLESHOOTING.md",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/store-replenish.csv",
      "prompt": "用这份 2 门店 × 8 SKU 的销售库存表，按 30 天窗口算补货建议，汇总成门店补货单并导出补货 CSV。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户指定的门店-商品销售库存 CSV（样例：samples/quickstart/input/store-replenish.csv）"
      ],
      "writes": [
        "$DSH_HOME/dsh-store-replenish/exports/"
      ],
      "network": false,
      "external": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "gate": "node scripts/gate.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "quickstart": "node samples/quickstart/run.mjs --check",
    "prepublishOnly": "npm run build && node scripts/lint.mjs && node scripts/gate.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "retail",
    "replenishment",
    "inventory",
    "stockout",
    "store-ops",
    "csv",
    "perrylink"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-store-replenish.git"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-store-replenish/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
